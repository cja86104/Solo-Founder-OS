# ==============================================================================
# Solo Founder OS - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# Your application's public URL (no trailing slash)
# Used for: Stripe redirects, email links, landing page URLs, OpenRouter referer
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
# Public URL and anon key are safe to expose client-side
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key - NEVER expose client-side, server-only
# Has full database access, bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------------------
# Found in: Stripe Dashboard > Developers > API keys
# Use test keys (sk_test_*, pk_test_*) for development
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret
# Found in: Stripe Dashboard > Developers > Webhooks > Select endpoint > Signing secret
# For local dev: use Stripe CLI `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs for subscription products
# Found in: Stripe Dashboard > Products > Select product > Pricing > Price ID
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...

# ------------------------------------------------------------------------------
# AI / LLM
# ------------------------------------------------------------------------------
# OpenRouter API key for AI Advisor (uses DeepSeek model)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ------------------------------------------------------------------------------
# Email
# ------------------------------------------------------------------------------
# Resend API key for transactional emails (workspace invites, etc.)
# Get yours at: https://resend.com/api-keys
# Optional: emails will be skipped if not configured
RESEND_API_KEY=re_...
