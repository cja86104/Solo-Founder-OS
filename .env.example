# ================================================
# Founders Helm — Environment Variables
# ================================================
# Copy this file to .env.local for local development.
# All variables marked REQUIRED must be set in production.

# ------------------------------------------------
# Supabase (REQUIRED)
# ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------
# App URL (REQUIRED)
# Set to your production domain in Vercel env vars.
# ------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------
# Stripe (REQUIRED for billing)
# Get keys at: https://dashboard.stripe.com/apikeys
# ------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# Stripe Price IDs — create these in your Stripe dashboard
# Products > Add product > Add a price, copy the price_xxx ID
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-pro-monthly-id
STRIPE_PRO_YEARLY_PRICE_ID=price_your-pro-yearly-id
STRIPE_LIFETIME_PRICE_ID=price_your-lifetime-id

# ------------------------------------------------
# AI — OpenRouter (REQUIRED for Advisor + Content)
# Get key at: https://openrouter.ai/keys
# ------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-key

# ------------------------------------------------
# Email — Resend (REQUIRED for workspace invites + automations)
# Get key at: https://resend.com/api-keys
# ------------------------------------------------
RESEND_API_KEY=re_your-key

# ------------------------------------------------
# Cron Security (REQUIRED for automation scheduler)
# Set this in your Vercel project env vars.
# Vercel automatically attaches "Authorization: Bearer <value>"
# to all cron job requests — the /api/cron/automations route
# validates against this value.
# Generate with: openssl rand -hex 32
# ------------------------------------------------
CRON_SECRET=your-random-secret-here
